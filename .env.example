DATABASE_URL=
DATABASE_URL_UNPOOLED=
ApplicationSettings__JWT_Secret=
ApplicationSettings__JWT_Issuer=portfolio-api
ApplicationSettings__JWT_Audience=portfolio-web
Security__EmailConfirmationSecret=
# During a confirmation-key rotation only; remove after the longest pending-link/outbox window.
Security__PreviousEmailConfirmationSecret=
App__FrontendUrl=
CORS_ALLOWED_ORIGINS=
EnableSwagger=false
CRON_SECRET=
Security__PasswordHashIterations=220000

# Optional: configure an OTLP-compatible observability backend.
# Production requires HTTPS. Development permits HTTP only for loopback collectors.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-me

# Required in Production for durable outbox delivery.
Email__SmtpHost=
Email__SmtpPort=465
Email__Username=
Email__Password=
Email__From=
Email__EnableSsl=true
Email__UseImplicitSsl=true
Email__TimeoutMilliseconds=30000
# Temporary Production cutover only; remove or set false immediately after HashLegacyRefreshTokens.
Security__AllowLegacyRefreshTokenLookup=false
