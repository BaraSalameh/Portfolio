{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "JWT_Issuer": "portfolio-api",
    "JWT_Audience": "portfolio-web"
  },
  "App": {
    "LogoUrl": "https://res.cloudinary.com/dxebzmnn9/image/upload/v1751210211/portfolio-logo_tmfs7l.png"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "PasswordHashIterations": 220000
  },
  "EnableSwagger": false
}
