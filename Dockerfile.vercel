FROM mcr.microsoft.com/dotnet/sdk:8.0.424@sha256:bb32ba3ba3ea36e38572d9d8db76fa15f7cbf722f3f886e06bca6d528bd4fba8 AS build
WORKDIR /src

COPY . .
# Dependabot updates the lock file owned by the project it changes, but NuGet
# also invalidates lock files in projects that reference that project. Re-evaluate
# the full solution inside this disposable build stage so dependency-update
# previews can build; CI still verifies committed lock files with --locked-mode.
RUN dotnet restore Portfolio.sln --force-evaluate
RUN dotnet publish Portfolio/Portfolio.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0.11@sha256:a4556ed033fa96f984bb7a8d348851cb2d36b1281dd2420070045f664fbb5f94 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 3000

USER app
CMD ["sh", "-c", "dotnet Portfolio.dll --urls http://0.0.0.0:${PORT:-3000}"]
